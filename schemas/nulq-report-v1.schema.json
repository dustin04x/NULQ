{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nulq.dev/schemas/nulq-report-v1.schema.json",
  "title": "NULQ assessment report",
  "description": "Version 1.1 report emitted by `nulq scan --format json` and `nulq system info --format json`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "host", "scan", "findings", "evidence", "stats", "coverage", "limitations"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "tool": { "$ref": "#/$defs/tool" },
    "host": { "$ref": "#/$defs/host" },
    "scan": { "$ref": "#/$defs/scan" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "observations": {
      "description": "Present only when observations were requested. Absent otherwise.",
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "stats": { "$ref": "#/$defs/stats" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "go_version", "platform"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "build_date": { "type": "string" },
        "go_version": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "architecture", "container"],
      "properties": {
        "hostname": { "type": "string" },
        "os_id": { "type": "string" },
        "os_name": { "type": "string" },
        "os_version": { "type": "string" },
        "kernel_release": { "type": "string" },
        "architecture": { "type": "string" },
        "container": { "type": "boolean" },
        "container_runtime": { "type": "string" },
        "security_modules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "started_at", "finished_at", "duration_ms", "modules", "unprivileged", "partial"],
      "properties": {
        "report_id": { "type": "string", "pattern": "^rpt-[0-9a-f]{12}$" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "modules": { "type": "array", "items": { "type": "string" } },
        "scan_roots": { "type": "array", "items": { "type": "string" } },
        "unprivileged": { "type": "boolean" },
        "partial": { "type": "boolean" }
      }
    },
    "severity": { "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "rule_id", "rule_version", "title", "description", "category",
        "severity", "confidence", "resource", "resource_kind", "evidence",
        "explanation", "impact", "remediation", "detected_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^fnd-[0-9a-f]{12}$" },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "resource": { "type": "string", "minLength": 1 },
        "resource_kind": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^ev-[0-9a-f]{12}$" }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "impact": { "type": "string" },
        "remediation": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "detected_at": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observation_id", "resource", "collector", "observed_value", "explanation", "collected_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^ev-[0-9a-f]{12}$" },
        "observation_id": { "type": "string", "pattern": "^obs-[a-z0-9_-]+-[0-9a-f]{12}$" },
        "resource": { "type": "string" },
        "resource_kind": { "type": "string" },
        "collector": { "type": "string" },
        "field": { "type": "string" },
        "observed_value": { "type": "string" },
        "expected_value": { "type": "string" },
        "explanation": { "type": "string" },
        "collected_at": { "type": "string", "format": "date-time" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "resource", "collector", "collected_at", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^obs-[a-z0-9_-]+-[0-9a-f]{12}$" },
        "kind": {
          "enum": [
            "system.info", "system.security_control", "system.sysctl",
            "identity.execution_context", "identity.group_membership",
            "filesystem.file", "filesystem.directory", "filesystem.path_entry",
            "filesystem.mount", "filesystem.scan", "process.info",
            "filesystem.capability", "identity.sudo_rule", "identity.cron_job",
            "system.container_indicator", "system.kernel_mitigation",
            "identity.user_account", "system.sshd_config", "identity.ssh_authorized_keys"
          ]
        },
        "resource": { "type": "string" },
        "collector": { "type": "string" },
        "collected_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["complete", "partial", "unavailable", "error"] },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "note": { "type": "string" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "message"],
          "properties": {
            "class": {
              "enum": [
                "permission_denied", "not_found", "unavailable", "unsupported",
                "malformed_input", "timeout", "canceled", "resource_exhausted", "internal"
              ]
            },
            "message": { "type": "string" },
            "resource": { "type": "string" }
          }
        }
      }
    },
    "coverage": {
      "description": "What the scan actually observed, independent of whether it ran to completion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "execution_complete", "coverage_complete", "files_examined",
        "directories_examined", "traversal_errors", "permission_denied",		"unavailable_observations", "unsupported_observations", "truncated_roots",
		"excluded_roots", "skipped_rules", "failed_operations", "roots"
	],
      "properties": {
        "status": { "enum": ["complete", "partial", "limited", "failed"] },
        "execution_complete": { "type": "boolean" },
        "coverage_complete": { "type": "boolean" },
        "files_examined": { "type": "integer", "minimum": 0 },
        "directories_examined": { "type": "integer", "minimum": 0 },
        "traversal_errors": { "type": "integer", "minimum": 0 },
        "permission_denied": { "type": "integer", "minimum": 0 },
        "unavailable_observations": { "type": "integer", "minimum": 0 },
        "unsupported_observations": { "type": "integer", "minimum": 0 },		"truncated_roots": { "type": "array", "items": { "type": "string" } },
		"excluded_roots": {
			"description": "Mount points deliberately not scanned, for example pseudo filesystems, container storage and snapshot trees. Distinct from traversal errors.",
			"type": "array",
			"items": { "type": "string" }
		},
		"skipped_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "reason"],
            "properties": {
              "rule_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            }			}
		},
		"failed_operations": {
			"description": "Collectors or rules that did not complete, with a classified reason such as timeout or canceled.",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["operation", "class"],
				"properties": {
					"operation": { "type": "string", "minLength": 1 },
					"class": { "type": "string", "minLength": 1 },
					"message": { "type": "string" }
				}
			}
		},
		"roots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root", "status", "files_examined", "directories_examined",
              "traversal_errors", "permission_denied", "truncated"
            ],
            "properties": {
              "root": { "type": "string", "minLength": 1 },
              "status": { "enum": ["complete", "partial", "unavailable"] },
              "files_examined": { "type": "integer", "minimum": 0 },
              "directories_examined": { "type": "integer", "minimum": 0 },
              "traversal_errors": { "type": "integer", "minimum": 0 },
              "permission_denied": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "unavailable_observations", "findings", "evidence", "rules", "collectors"],
      "properties": {
        "observations": { "type": "integer", "minimum": 0 },
        "unavailable_observations": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "integer", "minimum": 0 },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "executed", "skipped", "failed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "executed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "collectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "observations", "duration_ms"],
            "properties": {
              "name": { "type": "string" },
              "status": { "enum": ["ok", "failed"] },
              "observations": { "type": "integer", "minimum": 0 },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "error": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
