# Optional overrides for the NULQ laboratory.
#
# The Makefile targets work without this file: scripts export absolute paths.
# Copy to lab/.env only if you deliberately need different values.

# Image tag built from lab/docker/alpine/Dockerfile.
# LAB_IMAGE=nulq-lab/alpine-target:3.22

# Absolute path to the real nulq binary. Must stay read-only in the container.
# Leave unset to use ../bin/nulq relative to lab/compose.yaml.
# NULQ_BINARY=/absolute/path/to/bin/nulq

# Do NOT add privileged mode, host namespaces, added capabilities, Docker
# socket mounts or host filesystem mounts here. The scripts reject them.
