{
  "schema_version": "1.0",
  "target": "Alpine Linux 3.22 (BusyBox), linux/amd64",
  "description": "Scenario contract for the NULQ Alpine laboratory. Supported scenarios are evaluated against the real binary's JSON. Severity assertions require evidence-justified exposure; unsupported scenarios document checks that no rule implements yet and are never reported as passes.",
  "artifacts": {
    "baseline": "scan.json",
    "fixtures": "scan-fixtures.json",
    "path": "scan-path.json",
    "identity": "scan-identity.json",
    "discovery": "scan-discovery.json"
  },
  "scenarios": [
    {
      "id": "ID-001",
      "title": "Assessment runs unprivileged on Alpine",
      "category": "identity",
      "environment": "live",
      "supported": true,
      "scan": "baseline",
      "description": "The real binary executes as uid 10001 inside the container, reports unprivileged execution and identifies the target OS.",
      "expect": {
        "observations": [
          {
            "kind": "identity.execution_context",
            "attr": "euid",
            "equals": "10001"
          },
          {
            "kind": "system.info",
            "attr": "os_id",
            "equals": "alpine"
          }
        ],
        "report": {
          "unprivileged": true
        },
        "coverage": {
          "status": "partial",
          "complete": false,
          "execution_complete": true,
          "permission_denied_min": 1
        },
        "allowed_findings": [
          {
            "rule_id": "NULQ-SYS-001",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-006",
            "match": "any"
          }
        ]
      }
    },
    {
      "id": "ID-002",
      "title": "Container context is detected",
      "category": "identity",
      "environment": "live",
      "supported": true,
      "scan": "baseline",
      "description": "NULQ records that it assessed a container rather than a bare-metal host.",
      "expect": {
        "observations": [
          {
            "kind": "system.info",
            "attr": "container",
            "equals": "true"
          }
        ]
      }
    },
    {
      "id": "ID-003",
      "title": "No privileged group membership in the baseline",
      "category": "identity",
      "environment": "live",
      "supported": true,
      "scan": "baseline",
      "description": "The baseline account belongs only to its own group, so NULQ-ID-001 must stay silent.",
      "expect": {
        "absent_findings": [
          {
            "rule_id": "NULQ-ID-001",
            "match": "any"
          }
        ]
      }
    },
    {
      "id": "ID-004",
      "title": "Wheel membership is reported as contextual LOW",
      "category": "identity",
      "environment": "live",
      "supported": true,
      "scan": "identity",
      "description": "The runtime grants wheel (gid 10) as a supplementary group. Actual sudo authority is not evaluated, so the rule reports a LOW membership observation.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-ID-001",
            "resource": "group:wheel",
            "match": "exact",
            "severity": "LOW",
            "confidence": "HIGH",
            "min": 1,
            "max": 1
          }
        ],
        "coverage": {
          "status": "complete",
          "execution_complete": true
        },
        "report": {
          "unprivileged": true
        }
      }
    },
    {
      "id": "FS-001",
      "title": "World-writable directory without sticky bit",
      "category": "filesystem",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A 0777 root-owned directory is reported MEDIUM with MEDIUM confidence, attributed to the exact fixture path.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/fs/world-writable",
            "match": "exact",
            "severity": "MEDIUM",
            "confidence": "MEDIUM",
            "min": 1,
            "max": 1
          }
        ],
        "allowed_findings": [
          {
            "rule_id": "NULQ-SYS-001",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-006",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-007",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-008",
            "match": "any"
          }
        ]
      }
    },
    {
      "id": "FS-002",
      "title": "Sticky and group-writable directories stay silent",
      "category": "filesystem",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A 1777 directory restricts deletion and a 0770 root:wheel directory is not world-writable; neither may produce a finding.",
      "expect": {
        "absent_findings": [
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/fs/world-writable-sticky",
            "match": "exact"
          },
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/fs/group-writable",
            "match": "exact"
          }
        ]
      }
    },
    {
      "id": "FS-003",
      "title": "Nested world-writable directory is attributed correctly",
      "category": "filesystem",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A deeply nested 0777 directory must be found and attributed to its own path, not its parent.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/fs/nested/deep/world-writable",
            "match": "exact",
            "severity": "MEDIUM",
            "min": 1,
            "max": 1
          }
        ],
        "absent_findings": [
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/fs/nested/deep",
            "match": "exact"
          }
        ]
      }
    },
    {
      "id": "FS-004",
      "title": "World-writable directory containing a privileged executable escalates",
      "category": "filesystem",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "The same directory permission becomes HIGH only because it contains a set-owner-ID executable that can be replaced.",
      "expect": {
        "findings": [
