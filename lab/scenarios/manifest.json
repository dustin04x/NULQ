        ]
      }
    },
    {
      "id": "FS-005",
      "title": "Set-owner-ID executable outside standard directories",
      "category": "suid-sgid",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A root-owned SUID binary outside distribution binary directories is inventory worth review (LOW). Location alone does not establish exposure.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/lab/fixtures/suid/root-owned-tool",
            "match": "exact",
            "severity": "LOW",
            "confidence": "HIGH",
            "min": 1,
            "max": 1
          }
        ]
      }
    },
    {
      "id": "FS-006",
      "title": "SGID executable inventory",
      "category": "suid-sgid",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A root:wheel SGID binary is inventoried as LOW with evidence for both owner bits. The SGID bit alone is not a vulnerability.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/lab/fixtures/suid/sgid-tool",
            "match": "exact",
            "severity": "LOW",
            "min": 1,
            "max": 1
          }
        ]
      }
    },
    {
      "id": "FS-007",
      "title": "User-owned SUID executable crosses no user boundary",
      "category": "suid-sgid",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A SUID binary owned by uid 10001 and writable by that same account is LOW: executing it returns the caller's own credentials. It must never be reported as MEDIUM or HIGH.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/lab/fixtures/suid/user-owned-tool",
            "match": "exact",
            "severity": "LOW",
            "min": 1,
            "max": 1
          }
        ],
        "absent_findings": [
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/lab/fixtures/suid/user-owned-tool",
            "match": "exact",
            "severity": "HIGH"
          },
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/lab/fixtures/suid/user-owned-tool",
            "match": "exact",
            "severity": "MEDIUM"
          }
        ]
      }
    },
    {
      "id": "FS-008",
      "title": "Ordinary files produce no SUID finding",
      "category": "suid-sgid",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "Negative control: a 0755 binary without owner bits is not inventoried.",
      "expect": {
        "absent_findings": [
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/lab/fixtures/suid/plain-tool",
            "match": "exact"
          }
        ]
      }
    },
    {
      "id": "FS-009",
      "title": "Standard-directory privileged executable is INFO inventory",
      "category": "suid-sgid",
      "environment": "synthetic",
      "supported": true,
      "scan": "baseline",
      "description": "Baseline calibration: /usr/lib/lab/standard-suid is distribution-style inventory (INFO). It is not a live distribution binary, but it exercises the location rule honestly.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-001",
            "resource": "/usr/lib/lab/standard-suid",
            "match": "exact",
            "severity": "INFO",
            "min": 1,
            "max": 1
          }
        ],
        "max_severity": "MEDIUM",
        "allowed_findings": [
          {
            "rule_id": "NULQ-SYS-007",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-008",
            "match": "any"
          }
        ]
      }
    },
    {
      "id": "FS-010",
      "title": "Unreadable subtree yields partial coverage, not silence",
      "category": "coverage",
      "environment": "synthetic",
      "supported": true,
      "scan": "fixtures",
      "description": "A root-owned 0700 directory cannot be entered by uid 10001. Coverage must be partial, execution complete, and the denial counted.",
      "expect": {
        "coverage": {
          "status": "partial",
          "complete": false,
          "execution_complete": true,
          "permission_denied_min": 1
        }
      }
    },
    {
      "id": "FS-011",
      "title": "Writable PATH directory is contextual LOW, not HIGH",
      "category": "path-hijack",
      "environment": "synthetic",
      "supported": true,
      "scan": "path",
      "description": "A root-owned 0777 directory in PATH is a world-writable directory (FS-002 MEDIUM) and a writable PATH entry (FS-003 LOW). No privileged consumer is observed, so neither finding is HIGH.",
      "expect": {
        "findings": [
          {
            "rule_id": "NULQ-FS-003",
            "resource": "/lab/fixtures/path/writable",
            "match": "exact",
            "severity": "LOW",
            "min": 1,
            "max": 1,
            "confidence": "HIGH"
          },
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/path/writable",
            "match": "exact",
            "severity": "MEDIUM",
            "min": 1,
            "max": 1,
            "confidence": "MEDIUM"
          }
        ],
        "absent_findings": [
          {
            "rule_id": "NULQ-FS-003",
            "resource": "/lab/fixtures/path/writable",
            "match": "exact",
            "severity": "HIGH"
          },
          {
            "rule_id": "NULQ-FS-002",
            "resource": "/lab/fixtures/path/writable",
            "match": "exact",
            "severity": "HIGH"
          }
        ],
        "allowed_findings": [
          {
            "rule_id": "NULQ-SYS-001",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-006",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-007",
            "match": "any"
          },
          {
            "rule_id": "NULQ-SYS-008",
            "match": "any"
          }
        ]
      }
    },
    {
