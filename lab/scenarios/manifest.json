    {
      "id": "FS-016",
      "title": "Pseudo filesystems and host namespaces are excluded",
      "category": "coverage",
      "environment": "live",
      "supported": true,
      "scan": "baseline",
      "description": "Mounts are observed, but /proc, /sys, /dev and /run are never traversed as assessable filesystems.",
      "expect": {
        "observations": [
          {
            "kind": "filesystem.mount",
            "resource": "/proc"
          }
        ],
        "report": {
          "include_roots": [
            "/"
          ],
          "exclude_roots": [
            "/proc",
            "/sys",
            "/dev",
            "/run"
          ]
        }
      }
    },
